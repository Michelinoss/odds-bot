modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Background odds worker"

[[workflows.workflow]]
name = "Background odds worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python worker.py"

[workflows.workflow.metadata]
outputType = "console"
